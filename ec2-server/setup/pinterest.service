[Unit]
Description=Pinterest infinite scroll image server
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/app/ec2-server
Environment=PORT=80
# Lets a non-root user bind to port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
